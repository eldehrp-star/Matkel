# Base de datos Postgres (Neon, Render, Supabase, etc.)
DATABASE_URL="postgresql://usuario:password@host:5432/matkel?sslmode=require"

# Puerto del servidor
PORT=4000

# Secreto para firmar tokens de sesion del personal (genera uno largo y aleatorio)
JWT_SECRET="cambia-esto-por-un-valor-largo-y-aleatorio"

# --- Integracion con Clip ---
# Llave de API entregada por developer.clip.mx (Bearer token para llamar a su API de Transacciones)
CLIP_API_KEY=""
# Base URL de la API de Clip (verificar el valor exacto en developer.clip.mx una vez tengas cuenta)
CLIP_API_BASE_URL="https://api.clip.mx"

# Secreto compartido para validar que los webhooks realmente vienen de Clip.
# Configura el mismo valor en el panel de Clip al registrar la URL del webhook.
CLIP_WEBHOOK_SECRET="cambia-esto-tambien"
# Nombre del header donde Clip manda la firma/token del webhook (ajustar segun su documentacion)
CLIP_WEBHOOK_SIGNATURE_HEADER="x-clip-signature"

# Usuario administrador inicial que crea el script de seed
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PIN="1234"

# Origen permitido para CORS (URL donde vive el frontend)
CORS_ORIGIN="http://localhost:5173"
